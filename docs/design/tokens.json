{
  "version": 1,
  "platform": "macOS",
  "units": "pt for native layout; px equivalents for review preview",
  "primitive": {
    "space": {"xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32},
    "radius": {"sm": 8, "md": 12, "lg": 16},
    "fontSize": {"caption": 12, "body": 13, "section": 15, "title": 18, "page": 22, "count": 24},
    "motion": {"feedback": 120, "state": 180},
    "color": {
      "light": {
        "surface": "#FFFFFF", "sidebar": "#F2F3F5", "canvas": "#E8EBF0",
        "raised": "#F7F8FA", "text": "#202124", "muted": "#5E6470", "border": "#D7DAE1",
        "accent": "#0759C7", "onAccent": "#FFFFFF", "selection": "#E9F1FF",
        "success": "#176B3A", "successSurface": "#E7F4EA",
        "warning": "#8A4B00", "warningSurface": "#FFF2DC",
        "danger": "#B42318", "dangerSurface": "#FDECEB",
        "purple": "#6740AF", "purpleSurface": "#F0EAFB"
      },
      "dark": {
        "surface": "#202124", "sidebar": "#282A2E", "canvas": "#141619",
        "raised": "#2D3035", "text": "#F4F5F7", "muted": "#BBC1CB", "border": "#50555F",
        "accent": "#A7CCFF", "onAccent": "#17253A", "selection": "#263B5B",
        "success": "#8ED9A6", "successSurface": "#213E2A",
        "warning": "#F5C77C", "warningSurface": "#443621",
        "danger": "#FFA6A0", "dangerSurface": "#492B2B",
        "purple": "#D3BDFF", "purpleSurface": "#392D50"
      }
    }
  },
  "semantic": {
    "color": {
      "surface": {"reference": "primitive.color.$theme.surface", "native": "NSColor.windowBackgroundColor"},
      "sidebar": {"reference": "primitive.color.$theme.sidebar", "native": "system sidebar appearance"},
      "canvas": {"reference": "primitive.color.$theme.canvas", "native": "review preview only"},
      "raised": {"reference": "primitive.color.$theme.raised", "native": "system grouped content surface"},
      "text": {"reference": "primitive.color.$theme.text", "native": "Color.primary"},
      "muted": {"reference": "primitive.color.$theme.muted", "native": "Color.secondary"},
      "border": {"reference": "primitive.color.$theme.border", "native": "NSColor.separatorColor"},
      "accent": {"reference": "primitive.color.$theme.accent", "native": "Color.accentColor"},
      "onAccent": {"reference": "primitive.color.$theme.onAccent", "native": "system button foreground"},
      "selection": {"reference": "primitive.color.$theme.selection", "native": "system selection appearance"},
      "success": {"reference": "primitive.color.$theme.success", "native": "semantic success, paired label"},
      "successSurface": {"reference": "primitive.color.$theme.successSurface", "native": "semantic success surface"},
      "warning": {"reference": "primitive.color.$theme.warning", "native": "semantic warning, paired label"},
      "warningSurface": {"reference": "primitive.color.$theme.warningSurface", "native": "semantic warning surface"},
      "danger": {"reference": "primitive.color.$theme.danger", "native": "semantic error, paired label"},
      "dangerSurface": {"reference": "primitive.color.$theme.dangerSurface", "native": "semantic error surface"},
      "purple": {"reference": "primitive.color.$theme.purple", "native": "custom category color"},
      "purpleSurface": {"reference": "primitive.color.$theme.purpleSurface", "native": "custom category surface"}
    },
    "space": {"row": "primitive.space.md", "card": "primitive.space.lg", "section": "primitive.space.xl"},
    "radius": {"control": "primitive.radius.sm", "card": "primitive.radius.md"}
  },
  "component": {
    "tile": {"radius": "semantic.radius.card", "padding": "semantic.space.card", "minHeight": 80},
    "row": {"minHeight": 76, "padding": "semantic.space.row"},
    "finding": {"padding": "semantic.space.card", "radius": "semantic.radius.card"},
    "layout": {"sidebarWidth": 232, "listWidth": 320, "detailMinWidth": 440, "collapseWidth": 1120},
    "sheet": {"width": 640, "padding": "semantic.space.section"}
  }
}
